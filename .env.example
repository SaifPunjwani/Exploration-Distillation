WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=expdis
WANDB_GROUP=
WANDB_NOTES=

# expdis_jax (JAX/TPU) pipeline
EXPDIS_VLLM_SERVER_URLS=            # comma-separated vLLM OpenAI-compatible URLs, e.g. http://10.0.0.2:8000/v1
EXPDIS_REQUIRE_WANDB=1              # 0 = allow runs without W&B credentials
EXPDIS_HF_CHECKPOINT_REPO=          # your own HF dataset repo for checkpoint/trajectory mirroring
EXPDIS_HF_MIRROR_CHECKPOINTS=1      # 0 = keep checkpoints local only
RUNS_ROOT=                       # where launch_jax_pipeline.sh writes runs (default: $HOME/expdis/runs)

HF_ACCESS_TOKEN=
HF_TOKEN=

HF_HOME=.hf
HF_HUB_CACHE=.hf/hub
HF_DATASETS_CACHE=.hf/datasets
TRANSFORMERS_CACHE=.hf/transformers

PJRT_DEVICE=TPU
TPU_ACCELERATOR_TYPE=v4-8
TPU_SKIP_MDS_QUERY=1
TPU_WORKER_ID=0
TPU_WORKER_HOSTNAMES=localhost
