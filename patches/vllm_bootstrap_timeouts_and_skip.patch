+        echo "[vllm-slice] WARN launch failed worker=$w after $LAUNCH_RETRIES attempts; skipping"
+        worker_failed=1
+        break
+      fi
       echo "[vllm-slice] ERROR launch failed worker=$w after $LAUNCH_RETRIES attempts" >&2
