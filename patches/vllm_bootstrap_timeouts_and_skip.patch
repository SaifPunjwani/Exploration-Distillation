 VLLM_ENV_CACHE_GCS_URI="${VLLM_ENV_CACHE_GCS_URI:-gs://two-model-exploration-checkpoints/shared_envs/v5lite_vllm_tpu_0.13.3_py311.tar.gz}"
 LAUNCH_RETRIES="${TMX_VLLM_BOOTSTRAP_RETRIES:-4}"
 LAUNCH_RETRY_SLEEP="${TMX_VLLM_BOOTSTRAP_RETRY_SLEEP:-8}"
+SKIP_FAILED_WORKERS="${TMX_VLLM_SKIP_FAILED_WORKERS:-0}"
+SSH_CONNECT_TIMEOUT_SECONDS="${TMX_VLLM_SSH_CONNECT_TIMEOUT_SECONDS:-30}"
+SSH_SERVER_ALIVE_INTERVAL="${TMX_VLLM_SSH_SERVER_ALIVE_INTERVAL:-10}"
